# Doxygen override for Sphinx/Breathe XML generation
# Inherits all settings from the existing epsic.dox

@INCLUDE = ../Documentation/epsic.dox

FILE_PATTERNS          = *.h

# Redirect output into docs/_doxygen/epsic/
OUTPUT_DIRECTORY       = _doxygen/epsic

# Generate XML for Breathe, disable HTML
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Disable tag files (not needed for Breathe)
TAGFILES               =
GENERATE_TAGFILE       =

# Disable custom HTML header/footer (not generating HTML)
HTML_HEADER            =
HTML_FOOTER            =

# epsic source files contain ISO-8859-1 characters (± signs)
INPUT_ENCODING         = ISO-8859-1

# Drop std::* — Doxygen otherwise emits a stub namespacestd.xml that
# references std::allocator etc. with no body, breaking Breathe.
EXCLUDE_SYMBOLS        = std::*
