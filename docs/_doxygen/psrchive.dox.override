# Doxygen override for Sphinx/Breathe XML generation
# Inherits all settings from the existing psrchive.dox

@INCLUDE = ../Documentation/psrchive.dox

FILE_PATTERNS          = *.h

# Redirect output into docs/_doxygen/psrchive/
OUTPUT_DIRECTORY       = _doxygen/psrchive

# Generate XML for Breathe, disable HTML
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Disable tag files (not needed for Breathe)
TAGFILES               =
GENERATE_TAGFILE       =

# Disable custom HTML header/footer (not generating HTML)
HTML_HEADER            =
HTML_FOOTER            =

# Hide file-level documentation (classes/namespaces only)
SHOW_FILES             = NO

# Hide undocumented members to reduce noise
HIDE_UNDOC_MEMBERS     = YES

# Exclude undocumented format-specific structs and any std::* references
# (Doxygen otherwise emits a stub `namespacestd.xml` referencing
# std::allocator etc. with no body, which breaks Breathe at sphinx-build.)
EXCLUDE_SYMBOLS        = WAPP_HEADER* wapp_* std::*
