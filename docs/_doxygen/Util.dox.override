# Doxygen override for Sphinx/Breathe XML generation
# Inherits all settings from the existing Util.dox

@INCLUDE = ../Documentation/Util.dox

# Redirect output into docs/_doxygen/Util/
OUTPUT_DIRECTORY       = _doxygen/Util

# Generate XML for Breathe, disable HTML
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Disable tag files (not needed for Breathe)
TAGFILES               =
GENERATE_TAGFILE       =

# Disable custom HTML header/footer (not generating HTML)
HTML_HEADER            =
HTML_FOOTER            =
