# Doxygen override for Sphinx/Breathe XML generation
# Inherits all settings from the existing MEAL.dox

@INCLUDE = ../Documentation/MEAL.dox

# Redirect output into docs/_doxygen/MEAL/
OUTPUT_DIRECTORY       = _doxygen/MEAL

# Generate XML for Breathe, disable HTML
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Disable tag files (not needed for Breathe)
TAGFILES               =
GENERATE_TAGFILE       =

# Disable custom HTML header/footer (not generating HTML)
HTML_HEADER            =
HTML_FOOTER            =

# Drop std::* — Doxygen otherwise emits a stub namespacestd.xml that
# references std::allocator etc. with no body, breaking Breathe.
EXCLUDE_SYMBOLS        = std::*
