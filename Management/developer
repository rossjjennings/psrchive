#!/bin/bash -f

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  echo
  echo "developer: updates Git administration files with developer name"
  echo
  echo "usage:"
  echo "  Management/developer USER"
  echo
  echo "where:"
  echo "  USER is a sourceforge user name"
  echo
  exit
fi

if [ "$1" == "" ]; then
  echo "Git repository access changed to anonymous"
  git config remote.origin.url https://gitlab.com/pulsar-astronomy/psrchive.git
else
  echo "Git repository access changed to developer"
  git config remote.origin.url git@gitlab.com:pulsar-astronomy/psrchive.git

  remote_sf="ssh://$1@git.code.sf.net/p/psrchive/code"
  test_sf=$(git remote get-url sf)
  if [[ "$test_sf" != "$remote_sf" ]]; then
    echo "Adding sourceforge as a remote for user $1"
    git remote add sf $remote_sf
  fi
fi

