#!/usr/bin/env bash

# @configure_input@

# Exit immediately if a command exits with a non-zero status,
# and treat unset variables as an error
set -euo pipefail

mkdir -p @prefix@/src
cd @prefix@/src

if [ ! -d splinter ]; then

  echo "Downloading SPLINTER source code from github"

  SPLINTER_GIT=https://github.com/bgrimstad/splinter.git
  git clone $SPLINTER_GIT

fi

cd splinter
git pull
git checkout develop

mkdir -p build
cd build
cmake -DCMAKE_INSTALL_PREFIX=@prefix@ ..
make
make install

echo
echo
echo "SPLINTER library installation completed"
echo
echo "To use the library, please re-run the PSRCHIVE configure script"
echo
