#!/usr/bin/env bash

# @configure_input@

# Exit immediately if a command exits with a non-zero status,
# and treat unset variables as an error
set -euo pipefail

if [[ -v TEMPO2 ]]; then
  echo "using TEMPO2=$TEMPO2"
else
  TEMPO2=@prefix@/tempo2
  echo "setting TEMPO2=$TEMPO2"
fi

mkdir -p @prefix@/src
cd @prefix@/src

if [ ! -d tempo2 ]; then
  echo "Downloading TEMPO2 source code from GitHub"
  TEMPO2_GIT=https://github.com/ipta/tempo2.git
  git clone $TEMPO2_GIT
fi

cd tempo2
git pull

mkdir -p $TEMPO2
rsync -at T2runtime/* $TEMPO2

./bootstrap
./configure
make $*
make install

echo
echo
echo "TEMPO2 library installation completed"
echo
echo "To use the library, please set the environment variable"
echo
echo 'export TEMPO2=$TEMPO2'
echo
echo "and then re-run the PSRCHIVE configure script"
echo
